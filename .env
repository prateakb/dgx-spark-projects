# MUST use the service name from your docker-compose.yml
OPENAI_BASE_URL=http://qwen3-8b:8080/v1

# This name should match the --alias you set in the llama-server command
# (I recommend adding '--alias Qwen3-Coder-Next' to your gguf service command)
BIG_MODEL=Qwen3-Coder-Next
SMALL_MODEL=Qwen3-Coder-Next

# The alias Claude Code uses to identify the local model
CLAUDE_MODEL_ALIAS=claude-sonnet-4-6

# Match this EXACTLY to your "--ctx-size" flag in docker-compose.yml
# Your current flag is 32768. If you want 131k, update the flag too!
VLLM_MAX_CTX=131072

# --- Cloudflare Tunnel ---
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → Create → Docker
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# --- Claude Code Auth ---
# Path to your ~/.claude dir on the DGX host (contains credentials after `claude auth login`)
# Run `claude auth login` on the host once, then this gets mounted into the container.
CLAUDE_AUTH_DIR=~/.claude

# --- Zulip Connection ---
# Point at your existing Zulip instance (internal Docker URL or external URL)
ZULIP_URL=http://your-zulip-host:port

# Create a bot in Zulip: Settings → Bots → Add a new bot (type: Generic)
# Then copy the bot email and API key here.
ZULIP_BOT_EMAIL=claude-bot@your-zulip.example.com
ZULIP_BOT_API_KEY=your-bot-api-key
ZULIP_STREAM=claude-code
ZULIP_TOPIC=tasks

# Permissions mode: "unattended" (skip all) or "supervised" (relay to Zulip)
CLAUDE_PERMISSIONS_MODE=unattended
# Timeout in seconds for permission approval (supervised mode only)
APPROVAL_TIMEOUT=60