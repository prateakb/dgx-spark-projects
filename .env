# MUST use the service name from your docker-compose.yml
OPENAI_BASE_URL=http://qwen3-8b:8080/v1

# This name should match the --alias you set in the llama-server command
# (I recommend adding '--alias Qwen3-Coder-Next' to your gguf service command)
BIG_MODEL=Qwen3-Coder-Next
SMALL_MODEL=Qwen3-Coder-Next

# The alias Claude Code uses to identify the local model
CLAUDE_MODEL_ALIAS=claude-sonnet-4-6

# Match this EXACTLY to your "--ctx-size" flag in docker-compose.yml
# Your current flag is 32768. If you want 131k, update the flag too!
VLLM_MAX_CTX=131072