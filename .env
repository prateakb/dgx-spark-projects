# Point to the llama.cpp container port mapped to your host
OPENAI_BASE_URL=http://localhost:8080/v1

# The model name MUST match the exact file path inside the gguf container
BIG_MODEL=/models/Qwen3-Coder-Next-UD-Q4_K_XL.gguf
SMALL_MODEL=/models/Qwen3-Coder-Next-UD-Q4_K_XL.gguf

# The alias Claude Code will use
CLAUDE_MODEL_ALIAS=claude-sonnet-4-6

# Match this to the "-c 32768" flag in your docker-compose.yml
VLLM_MAX_CTX=131072